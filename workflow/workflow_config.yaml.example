# Monte Carlo Simulation Workflow Configuration
# This file configures the integrated workflow for particle physics simulations

workflow:
  name: "JpsiJpsiUpsilon_TPS"
  description: "Triple J/psi + Upsilon production via MPS"
  output_dir: "/eos/user/c/chiw/JpsiJpsiUps/MC_samples"
  temp_dir: "/tmp/mc_workflow"

# Matrix element generation settings
matrix_element:
  generator: "helac-onia"
  version: "2.7.6"
  
  # Use single condor job for all seeds (requirement 1)
  batch_mode: "single_job"
  seeds:
    start: 11
    end: 100
  
  # HELAC-Onia specific settings
  helac:
    addon: "pp_NOnia_MPS"
    config_template: "configs/run_HELAC.ho.tpl"
    states: [1, 1, 3]  # J/psi, J/psi, Upsilon(1S)
    
    physics:
      cmass: 1.54845
      bmass: 4.73020
      beam_energy: 6800  # GeV per beam
      
    generation:
      preunw: 3000000
      unwevt: 1000000000
      nmc: 200000000
      nopt: 20000000
      
    cuts:
      minptconia: 2.0
      minptbonia: 2.0
  
  # Automatic harvesting (requirement 1)
  harvest:
    enabled: true
    output_pattern: "sample_pp_nonia_mps_{seed}.lhe"
    destination: "{output_dir}/LHE"
    max_file_size_gb: 10
  
  # External LHE file support (requirement 6)
  external_lhe:
    enabled: false
    sources:
      - path: "/path/to/external_jpsi.lhe"
        label: "jpsi_external"
        post_process: true      # Apply splitting/shuffling
        auto_split: true        # Auto-split if > threshold
        split_threshold_mb: 1000
      - path: "/path/to/external_upsilon.lhe"
        label: "upsilon_external"  
        post_process: false     # Use as-is
        auto_split: false

# LHE preprocessing settings (requirement 2)
lhe_preprocessing:
  enabled: true
  
  # Two-tier split and shuffle
  split:
    tier1_size: 10000  # events per file
    tier2_size: 1000   # events per subfile
    shuffle: true
    
  # Event mixing settings (requirement: advanced recipes)
  mixing:
    enabled: false
    # Simple sources list (legacy mode)
    sources: []  # List of LHE file patterns to mix
    output_file: "mixed_events.lhe"
    
    # Advanced mix recipes (requirement: "3 from A, 1 from B" for QPS)
    # Examples:
    #   DPS: "jpsi.lhe:1,upsilon.lhe:1"
    #   TPS: "jpsi.lhe:2,gg.lhe:1"
    #   QPS: "jpsi.lhe:3,phi.lhe:1"
    recipe: ""
    
  # Gluon merging (requirement: selective sub-scattering merging)
  gluon_merging:
    enabled: false
    merge_distance: 0.4  # Delta R threshold
    # Specify which sub-scatterings to merge gluons in (0-indexed)
    # Example: [0, 2] merges gluons in 1st and 3rd sub-scatterings only
    merge_subscatterings: []  # Empty = merge in all
    merge_across_subscatterings: false  # Allow merging across sub-scatterings

# Showering settings (requirement 3: standalone Pythia8, CP5, Upsilon decays)
showering:
  enabled: true
  generator: "pythia8"
  version: "8.3"
  
  # Standalone Pythia8 (requirement: not via cmsRun)
  standalone: true
  executable: "bin/pythia8_shower"
  
  # Tuning (requirement: CP5 default, or external input)
  tuning: "CP5"  # Options: CP5, Monash2013, 4C
  
  # For color octet states, keep HepMC
  color_octet:
    enabled: false
    keep_hepmc: true
    mode: "color-octet"
    
  # For phi meson production (requirement: repeated showering)
  phi_meson:
    enabled: false
    mode: "phi"
    repeated_showering: true
    max_attempts: 100
  
  # Upsilon decay settings (requirement: 553, 100553, 200553 → μ+μ-)
  # These are automatically configured in standalone Pythia8 shower
  upsilon_decays:
    force_muon_decay: true  # Forces Υ(1S,2S,3S) → μ+μ-
    
  pythia_config:
    tune: "CP5"  # Will be overridden by 'tuning' above
    process_string: ""  # Auto-generated from LHE

# CMS simulation workflow (requirement 4)
simulation:
  enabled: true
  cmssw_version: "CMSSW_14_0_0"
  
  # Each step configured separately
  steps:
    gen:
      enabled: true
      config: "configs/cmssw/GEN_cfg.py"
      keep_output: false  # Delete after SIM
      
    sim:
      enabled: true
      config: "configs/cmssw/SIM_cfg.py"
      keep_output: false
      
    digi:
      enabled: true
      config: "configs/cmssw/DIGI_cfg.py"
      keep_output: false
      
    reco:
      enabled: true
      config: "configs/cmssw/RECO_cfg.py"
      keep_output: false
      
    skim:
      enabled: true
      config: "configs/cmssw/SKIM_cfg.py"
      keep_output: true  # MiniAOD
      
    ntuple:
      enabled: true
      config: "configs/cmssw/Ntuple_cfg.py"
      keep_output: true
  
  # Files to preserve (requirement 4)
  preserve:
    - "*.lhe"
    - "*.hepmc"
    - "*MiniAOD*.root"
    - "*Ntuple*.root"
  
  # Detector era configurations
  era_configs:
    Run2_2018:
      global_tag: "106X_upgrade2018_realistic_v15"
      pileup_file: ""
    Run3_2024:
      global_tag: "140X_mcRun3_2024_realistic_v2"
      pileup_file: ""

# Batch submission settings (requirement 5)
submission:
  # Primary: HTCondor with DAGman
  condor:
    enabled: true
    dagman: true
    job_flavour: "tomorrow"
    request_memory: "15GB"
    request_cpus: 8
    request_disk: "8G"
    accounting_group: ""
    
  # Alternative: CRAB
  crab:
    enabled: false
    config_template: "configs/crab/crab_cfg.py.template"
    site: "T2_CH_CERN"
    
# Extension hooks (requirement 5)
extensions:
  # Non-prompt J/psi from b quarks
  nonprompt_jpsi:
    enabled: false
    b_quark_production:
      generator: "pythia8"
      process: "HardQCD:hardbbbar"
      
  # Additional subscatterings
  additional_scatterings:
    enabled: false
    processes: []
